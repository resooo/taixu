<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 写入 Settings.Global（adb_wifi_enabled 等）所需，经 pm grant 一次性授予。 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 开机自动恢复无线调试。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- 零侵入初始化：Android 会在 Application 启动后自动调用本 Provider 的 onCreate，
             用于挂载按需自动开启钩子并执行启动预热，无需改动宿主 Application 类。 -->
        <provider
            android:name="top.wkbin.taixu.feature.adbautostart.AdbAutostartInitializer"
            android:authorities="${applicationId}.adbautostart.initializer"
            android:exported="false"
            android:enabled="true"
            android:initOrder="100" />

        <!-- 开机恢复 Receiver：由本模块自带声明，经库 Manifest 合并进宿主，
             上游 AndroidManifest.xml 无需任何改动。 -->
        <receiver
            android:name="top.wkbin.taixu.feature.adbautostart.AdbBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
